{
  "manifest_version": 3,
  "name": "Skybits Legacy Deep Scanner",
  "version": "1.2.0",
  "description": "Automatic persistent discovery recorder and deep scanner for the legacy Skybits portal.",
  "permissions": ["activeTab", "scripting", "tabs", "storage", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "action": {"default_title":"Skybits Legacy Deep Scanner","default_popup":"popup.html"},
  "background": {"service_worker":"background.js"},
  "content_scripts": [
    {"matches":["<all_urls>"],"js":["bridge.js"],"run_at":"document_start","world":"MAIN"},
    {"matches":["<all_urls>"],"js":["content.js"],"run_at":"document_idle","world":"ISOLATED"}
  ]
}
